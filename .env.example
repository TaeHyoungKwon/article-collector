# GitHub Personal Access Token for GitHub Models (used for LLM summarization, currently openai/gpt-4o-mini).
# Create a fine-grained token at https://github.com/settings/personal-access-tokens
# with the "Models: Read" account permission. No repo access needed.
# In GitHub Actions this is unnecessary — the workflow's built-in GITHUB_TOKEN is used
# (the workflow has `permissions: models: read`).
GITHUB_MODELS_TOKEN=github_pat_...

# Gmail account that sends the daily digest. Use the address itself (kth5604@gmail.com).
GMAIL_USER=kth5604@gmail.com

# Gmail app password (NOT your account password).
# 2FA must be enabled on the account, then create an app password at
#   https://myaccount.google.com/apppasswords
# 16-char string, spaces optional.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where to send the digest. Defaults to GMAIL_USER if unset.
RECIPIENT_EMAIL=kth5604@gmail.com

# (Optional) Obsidian vault name as it appears in Obsidian's vault list.
# When set, the email includes obsidian://open links that jump straight into the note.
OBSIDIAN_VAULT_NAME=articles-vault

# (Optional) Comma-separated keyword override. Defaults to the seven keywords in src/score.py.
# KEYWORDS=backend,AI,distributed system,LLM,RAG,Claude Code,Codex
